@model InstaApplication.Models.Produits

@{
    ViewData["Title"] = "Delete";
}



<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Produits</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-pzjw8f+ua7Kw1TIq0v8Fq1KN8zF6U8tx3VtV/htX0TtDeGVk4l+wNl0z6MOfqKxa" crossorigin="anonymous">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Produits.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InstaApplication.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="account-container">
        <div class="row">
            <p>Voulez vous vraiment supprimer ce produit</p>
                <hr />
                <dl>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Name)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Price)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Price)
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                <input type="submit" value="Supprimer" class="btn2-primary" />
                    <a asp-action="Index">Retour a la liste</a>
                </form>
            </div>

        </div>

</body>

</html>




