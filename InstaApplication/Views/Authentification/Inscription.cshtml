@{
}

@model Inscription
<h3>Entrez vos information d'inscription !!</h3>

<form asp-action="index" method="post">
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" value="Entrez votre nom" />

    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" value="Entrez votre Email" />
    </div>
    <div class="form-group">
        <label asp-for="Password" class="control-label"></label>
        <input asp-for="Password" class="form-control" value="Entrez votre mot de passe" />
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="control-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" value="Confirmer votre mot de passe" />
    </div>


        <button type="submit" class="btn btn-primary">S'inscrire</button>
        
</form>
