@model InstaApplication.Models.Client

@{
    ViewData["Title"] = "Delete";
}

<h1 style="text-align: center; color: #f44336; font-family: Arial, sans-serif;">Supprimer un client</h1>

<h3 style="text-align: center; font-family: Arial, sans-serif;">Êtes-vous sûr de vouloir supprimer ceci ?</h3>
<div style="margin: 20px auto; width: 50%; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); padding: 20px; border-radius: 10px; background-color: white; font-family: Arial, sans-serif;">
    <h4 style="color: #4CAF50; text-align: center;">Client</h4>
    <hr style="border: 1px solid #4CAF50;">
    <dl class="row" style="margin-top: 20px;">
        <dt class="col-sm-4" style="font-weight: bold; color: #4CAF50;">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
        <dt class="col-sm-4" style="font-weight: bold; color: #4CAF50;">@Html.DisplayNameFor(model => model.Prenom)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Prenom)</dd>
        <dt class="col-sm-4" style="font-weight: bold; color: #4CAF50;">@Html.DisplayNameFor(model => model.age)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.age)</dd>
        <dt class="col-sm-4" style="font-weight: bold; color: #4CAF50;">@Html.DisplayNameFor(model => model.adresse)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.adresse)</dd>
    </dl>

    <form asp-action="Delete" style="text-align: center; margin-top: 20px;">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" style="background-color: #f44336; border: none; padding: 10px 20px; font-size: 16px; color: white; border-radius: 5px; margin-right: 10px;" />
        <a asp-action="Index" style="text-decoration: none; color: #4CAF50; font-weight: bold;">Retour à la liste</a>
    </form>
</div>
