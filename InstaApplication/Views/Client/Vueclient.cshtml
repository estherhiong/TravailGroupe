@{
    var Client = ViewData["Client"] as Client;
}
<!DOCTYPE html>
<html>
    <head><title>Formulaire client</title></head>
    <body>
        <div class="align-content-center">
        <h1>Formulaire d'inscription</h1>
        <form action="/" method="post">
            <label>
                votre id <br />
            <input type="type" name="name" value="@Client.Id" />
            </label><br />
            <label>
                votre nom <br />
        <input type="type" name="name" value="@Client.Name" />
            </label><br />
